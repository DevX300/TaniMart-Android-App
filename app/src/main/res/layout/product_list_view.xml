<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/showProductDetail"
        android:layout_width="170dp"
        android:layout_height="300dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginVertical="10dp"
        android:layout_marginHorizontal="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="130dp">
                <ImageView
                    android:id="@+id/productImageCard"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"/>
                <TextView
                    android:id="@+id/discountPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="15dp"
                    android:background="@drawable/bg_discount_pill"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="-23%"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="12sp"/>
            </FrameLayout>
            <!--Image View-->


            <!--Text Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="10dp">

                <!--Product Title-->
                <TextView
                    android:id="@+id/productTitleCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:textColor="#1A1A1A"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:text="Product Card Text title for max 2 lines"/>

                <!--weight price always base price -->
                <TextView
                    android:id="@+id/productWeightCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="5 Kg"
                    android:textSize="14sp"
                    android:textColor="#9CA3AF"
                    android:layout_marginVertical="5dp"/>

                <!--review portion-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <!--Fixed-->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐ "
                        android:textSize="14sp"/>
                    <!--Rating-->
                    <TextView
                        android:id="@+id/productRatingCard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4.8 "
                        android:textColor="#6B7280"
                        android:textSize="14sp"/>
                    <!--Review-->
                    <TextView
                        android:id="@+id/productReviewscard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(234)"
                        android:textColor="#6B7280"
                        android:textSize="14sp"/>
                </LinearLayout>

                <!--Pricing-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">
                    <!--Text Price-->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_gravity="bottom">
                        <!--Discounted price or can be Base Price-->
                        <TextView
                            android:id="@+id/dicountBasePriceCard"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 1000.00"
                            android:layout_weight="1"
                            android:layout_gravity="bottom"
                            android:textSize="20sp"
                            android:textColor="#2E7D32"
                            android:textStyle="bold"/>
                        <!--cut base price-->
                        <TextView
                            android:id="@+id/cutPriceCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Rp 85.00"
                            android:textSize="16sp"
                            android:visibility="visible"/>
                    </LinearLayout>
                    <!--add to card button-->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/addProductToCart"
                        android:layout_width="37dp"
                        android:layout_height="37dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        app:backgroundTint="#2E7D32"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/outline_add_24"
                        app:iconTint="@android:color/white"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        android:layout_gravity="bottom"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>