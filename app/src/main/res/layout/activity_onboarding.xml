<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activities.OnboardingActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!--        Image layout-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="500dp"
            android:layout_weight="1">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/onboarding_image"
                android:src="@drawable/onboarding_img_ob"
                android:scaleType="centerCrop"/>
        </LinearLayout>


        <!--        Logo box-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="40dp"
            android:gravity="center_horizontal">
            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/fire_svgob" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TaniMart"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!--title layout        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="450dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="28dp"
            android:background="@drawable/onboarding_top_radius"
            android:layout_gravity="bottom">

            <!--   Title         -->
            <TextView
                android:id="@+id/onboarding_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Shopping for agricultural needs, Made Easier"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="4dp"/>

            <!--  Subtitle          -->
            <TextView
                android:id="@+id/onboarding_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="A trusted platform for Indonesian farmers — straight from the best producers."
                android:textSize="15sp"
                android:textColor="#6B7280"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginVertical="15dp">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/plant_svg_ob"
                    android:layout_gravity="start"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/quality_products"
                    android:textSize="16sp"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:layout_marginLeft="12dp"
                    android:textColor="#1A1A1A"/>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="icon_tick"
                    android:src="@drawable/task_alt_tickob"
                    app:tint="@color/black"
                    android:gravity="end"
                    android:tint="#FF00FF"
                    android:backgroundTint="@color/white"/>

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="15dp">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/money_bag_svg_ob"
                    android:layout_gravity="start"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Affordable Price"
                    android:textSize="16sp"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:layout_marginLeft="12dp"
                    android:textColor="#1A1A1A"/>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="icon_tick"
                    android:src="@drawable/task_alt_tickob"
                    app:tint="@color/black"
                    android:gravity="end"
                    android:tint="#FF00FF"
                    android:backgroundTint="@color/white"/>

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="15dp">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/truck_svg_ob"
                    android:layout_gravity="start"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fast Delivery"
                    android:textSize="16sp"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:layout_marginLeft="12dp"
                    android:textColor="#1A1A1A"/>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="icon_tick"
                    android:src="@drawable/task_alt_tickob"
                    app:tint="@color/black"
                    android:gravity="end"
                    android:tint="#FF00FF"
                    android:backgroundTint="@color/white"/>

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="15dp">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/handshake_svgob"
                    android:layout_gravity="start"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trusted Farmer Partner"
                    android:textSize="16sp"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:layout_marginLeft="12dp"
                    android:textColor="#1A1A1A"/>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="icon_tick"
                    android:src="@drawable/task_alt_tickob"
                    app:tint="@color/black"
                    android:gravity="end"
                    android:tint="#FF00FF"
                    android:backgroundTint="@color/white"/>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/onboarding_button"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Start Shopping"
                android:textSize="20dp"
                android:textStyle="bold"
                android:layout_marginTop="10dp"
                android:background="@drawable/onboarding_button_radius"
                app:backgroundTint="@null"/>

            <!-- Footer link           -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Already have an account? Log in"
                android:layout_marginTop="15dp"
                android:gravity="center"/>
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>