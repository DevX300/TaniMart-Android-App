<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".activities.ProductDetailActivity">
    <!-- Scrollable Part -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/buyLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- Image and buttons -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <!-- Product Image -->
                <ImageView
                    android:id="@+id/productDetailImage"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:background="#00FF00"
                    android:scaleType="centerCrop"/>
                <!--Back Button-->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/productDetailBack"
                    android:layout_width="37dp"
                    android:layout_height="37dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="50dp"
                    app:icon="@drawable/outline_chevron_backward_24"
                    app:iconTint="@android:color/black"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    android:translationX="15dp"
                    android:translationY="45dp"
                    android:translationZ="10dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/productToCart"
                    android:layout_width="57dp"
                    android:layout_height="57dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="50dp"
                    app:icon="@drawable/cart_svg_com"
                    app:iconTint="@android:color/black"
                    app:iconSize="30dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    android:layout_gravity="end"
                    android:translationX="-15dp"
                    android:translationY="45dp"
                    android:translationZ="10dp"/>
                <!-- Discount Pill Show-->
                <TextView
                    android:id="@+id/productDiscountPill"
                    android:layout_width="wrap_content"
                    android:layout_height="35dp"
                    android:layout_margin="15dp"
                    android:background="@drawable/bg_discount_pill"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="-23% OFF"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:layout_gravity="bottom"/>
            </FrameLayout>
            <!-- Product Text Details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="10dp">
                <!--Product Name -->
                <TextView
                    android:id="@+id/productTitleName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fruit from the store market and its very tasty"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:maxLines="2"/>
                <!--Ratin, Review, Sold -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:translationY="-6dp">
                    <!--Rating Bar -->
                    <RatingBar
                        android:id="@+id/productRatingBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:isIndicator="true"
                        android:numStars="5"
                        android:padding="0dp"
                        android:progressTint="#FFA726"
                        android:rating="2"
                        android:scaleX="0.45"
                        android:scaleY="0.45"
                        android:stepSize="0.5"
                        android:translationX="-66dp"
                        android:layout_gravity="center_vertical"/>
                    <!--Rating Number-->
                    <TextView
                        android:id="@+id/productRatingNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="3.5"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/tani_orange"
                        android:translationX="-120dp"
                        android:translationY="-1dp"/>
                    <!--Review Number -->
                    <TextView
                        android:id="@+id/reviewNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="(234)"
                        android:textColor="@color/tani_light_grey"
                        android:textSize="15sp"
                        android:translationX="-110dp"
                        android:translationY="-1dp"/>
                    <!--Sold Number -->
                    <TextView
                        android:id="@+id/soldNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.2k Sold"
                        android:textSize="15sp"
                        android:textColor="@color/tani_light_grey"
                        android:layout_gravity="center_vertical"
                        android:translationX="-80dp"
                        android:translationY="-1dp"/>
                </LinearLayout>
                <!--Pricing -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:translationY="-10dp">
                    <!--Discounted price or can be Base Price-->
                    <TextView
                        android:id="@+id/discountBasePrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 1000.00"
                        android:textSize="28sp"
                        android:textColor="@color/tani_green"
                        android:textStyle="bold"
                        android:layout_marginRight="10dp"/>
                    <!--cut base price-->
                    <TextView
                        android:id="@+id/cutPrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Rp 85.00"
                        android:textColor="@color/tani_light_grey"
                        android:textSize="18sp"
                        android:visibility="visible"/>
                </LinearLayout>
                <!--Price Box View-->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/pricePills"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"/>
                <!--Stock Availability -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:background="@drawable/rounded_rectangle"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="15dp">
                    <ImageView
                        android:id="@+id/stockAvailableSign"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:src="@drawable/circle_icon_bg"
                        android:layout_gravity="center"
                        android:translationY="1dp"/>    <!--Can Change Color to FF0000 -->
                    <TextView
                        android:id="@+id/productAvailability"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:textColor="#374151"
                        android:text="In Stock: " />   <!--Can be Out of Stock -->
                    <TextView
                        android:id="@+id/stockNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textColor="@color/tani_green"
                        android:text="500 item"
                        android:visibility="visible"/>    <!--can be invisible-->
                </LinearLayout>
            </LinearLayout>
            <!--Tab Specification and Description and Review -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="15dp">
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    app:tabIndicatorColor="@color/tani_green"
                    app:tabSelectedTextColor="@color/tani_green"
                    app:tabTextColor="@color/tani_dark_grey1"
                    android:layout_marginBottom="15dp"
                    android:background="@android:color/white"/>
                <TextView
                    android:id="@+id/productDetailDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer nec odio. Praesent libero. Sed cursus ante dapibus diam. Sed nisi. Nulla quis sem at nibh elementum imperdiet."
                    android:textSize="18sp"
                    android:textColor="@color/tani_dark_grey2"
                    android:visibility="visible"
                    android:layout_marginHorizontal="5dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/productDetailSpecification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginHorizontal="5dp"
                    android:nestedScrollingEnabled="false" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/productDetailReview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginHorizontal="5dp"/>
            </LinearLayout>
            <!--Quantity adder -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_margin="16dp">
                <!--Subtotal Text-->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quantity"
                    android:textColor="@color/tani_black"
                    android:textStyle="bold"
                    android:textSize="15sp"/>
                <View
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <!--Product adder -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="110dp"
                    android:layout_height="40dp"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@android:color/white">
                        <!--minus -->
                        <TextView
                            android:id="@+id/minusButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="−"
                            android:textSize="18sp"
                            android:textColor="@color/tani_green"/>
                        <!--Quantity -->
                        <TextView
                            android:id="@+id/cartQuantity"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:textColor="@color/tani_black"
                            android:gravity="center"
                            android:text="1"
                            android:textStyle="bold"/>
                        <!--plus -->
                        <TextView
                            android:id="@+id/plusButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="+"
                            android:textSize="18sp"
                            android:textColor="@color/tani_green"/>
                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:dividerColor="@color/tani_light_grey"
        app:layout_constraintBottom_toTopOf="@+id/buyLayout"/>
    <!-- Buy Buttons -->
    <LinearLayout
        android:id="@+id/buyLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="15dp"
        android:paddingBottom="15dp"
        android:paddingTop="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@android:color/white">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/productDetailToCart"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:padding="18dp"
            android:text="+Add to Cart"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/tani_green"
            android:backgroundTint="@color/white"
            app:strokeWidth="2dp"
            app:strokeColor="@color/tani_green"
            app:cornerRadius="16dp"/>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/productDetailToCheckout"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/tani_green"
            android:padding="18dp"
            android:text="Buy Now"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="16dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>