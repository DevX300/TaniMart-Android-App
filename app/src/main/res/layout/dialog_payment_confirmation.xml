<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:backgroundTint="@color/tani_black"
    android:background="@color/tani_black">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Confirm Payment"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/paymentConfirmationText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Do you want to continue with this payment method?"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total Amount"
        android:textStyle="bold"
        android:gravity="center"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/paymentConfirmationAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dialogPaymentButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Pay Now"
        android:backgroundTint="@color/tani_black"
        android:textSize="16sp" />

</LinearLayout>
