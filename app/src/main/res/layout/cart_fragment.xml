<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#f8faf8">

    <!--Navbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/nav_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@color/white">
        <!--Text Navbar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cartBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent">
            <!--Back Button-->
            <ImageView
                android:id="@+id/cartBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/outline_chevron_backward_24"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
            <!--Title-->
            <TextView
                android:id="@+id/cartName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cart"
                android:textColor="#1A1A1A"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <!-- Devider -->
        <com.google.android.material.divider.MaterialDivider
            android:id="@+id/div1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/cartBar"
            android:layout_marginTop="10dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--Body -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/nav_bar"
        app:layout_constraintBottom_toTopOf="@id/cartFooter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fillViewport="true">
        <!--Main Layout in nested scroll view -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <!--Select navbar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@android:color/white"
                android:paddingHorizontal="15dp">
                <CheckBox
                    android:id="@+id/cartSelectAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/tani_green"/>
                <TextView
                    android:id="@+id/cartSelectAllText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#374151"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:text="Select All"/>
                <View
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
                <!--Selected View -->
                <TextView
                    android:id="@+id/selectedNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tani_light_grey"
                    android:textSize="13sp"
                    android:text="0 Selected"/>
            </LinearLayout>
            <!-- Devider -->
            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/div"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <!--Cart List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/cartListView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:nestedScrollingEnabled="false"/>
            <!--Promo Pill -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/selectVoucherCart"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#F3F4F6"
                app:strokeWidth="1dp"
                android:layout_margin="15dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="center_vertical"
                    android:paddingHorizontal="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏷️"
                        android:textSize="20sp"
                        android:rotation="90"
                        android:layout_marginRight="20dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="16sp"
                        android:text="Use a Voucher / Promo"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select"
                        android:textSize="16sp"
                        android:textColor="@color/tani_green"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="→"
                        android:textSize="16sp"
                        android:translationY="-2dp"
                        android:textColor="@color/tani_green"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!--Purchase Summary -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/purchaseSummaryView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginBottom="0dp"
                app:cardBackgroundColor="@color/white"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#F3F4F6"
                app:shapeAppearanceOverlay="@style/PurchaseSummaryShape"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/spending_summary"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/tani_black"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/spendingSummaryCartList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"/>
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <!--Footer Sticky -->
    <LinearLayout
        android:id="@+id/cartFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintBottom_toTopOf="@+id/buyLayout"/>
        <!-- Buy Buttons -->
        <LinearLayout
            android:id="@+id/buyLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="15dp"
            android:paddingTop="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@android:color/white">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/cartFooterItem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tani_light_grey"
                    android:textSize="12sp"
                    android:text="Total(0 Item)"/>
                <TextView
                    android:id="@+id/cartFooterPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textColor="@color/tani_green"
                    android:textSize="20sp"
                    android:text="RP 00000"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cartFooterToCheckout"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/tani_green"
                android:padding="18dp"
                android:text="Checkout(0)"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>